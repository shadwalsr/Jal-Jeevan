# ============================================================
# JalJeev — Environment Configuration Template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Core ---
ENV=development
SECRET_KEY=change_me_dev_only
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://jaljeev:jaljeev_dev_password@localhost:5433/jaljeev
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=jaljeev
S3_SECRET_KEY=jaljeev_dev_password
S3_BUCKET=jaljeev-raw

# --- LLM ---
GEMINI_API_KEY=                    # https://aistudio.google.com/apikey (free tier available)

# --- Voice (optional, Phase 3) ---
GOOGLE_CLOUD_STT_KEY_PATH=         # Google Cloud service account JSON path
GOOGLE_CLOUD_TTS_KEY_PATH=

# ============================================================
# TIER 1 — DATA SOURCE CREDENTIALS (register these FIRST — Day 1)
# ============================================================

# ISRO MOSDAC — https://www.mosdac.gov.in  (register -> free account, 1-2 business days)
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# IMD API — https://mausam.imd.gov.in / https://api.imd.gov.in (register for API access)
IMD_API_KEY=

# Copernicus Marine Service — https://marine.copernicus.eu (free account, same-day)
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# Copernicus Climate Data Store (ERA5) — https://cds.climate.copernicus.eu (free, same-day)
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# NASA Earthdata (CMR + OceanColor) — https://urs.earthdata.nasa.gov (free, same-day)
# Either username/password OR a bearer token (Profile -> Generate Token) works.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# Protected Planet API — https://api.protectedplanet.net (free research key, 2-5 days)
PROTECTED_PLANET_API_KEY=

# Global Fishing Watch — https://globalfishingwatch.org/our-apis (free research account, 3-7 days)
GFW_API_TOKEN=

# ============================================================
# NO REGISTRATION REQUIRED (public / open, wire up any time)
# ============================================================
# INCOIS ERDDAP:      https://erddap.incois.gov.in/erddap
# NOAA OISST ERDDAP:   https://coastwatch.pfeg.noaa.gov/erddap
# Argo GDAC:           https://argo.ucsd.edu/data  |  https://argovis.colorado.edu
# HYCOM OPeNDAP:       https://www.hycom.org/dataserver
# Marine Regions EEZ:  https://marineregions.org/downloads.php
# GEBCO bathymetry:    https://www.gebco.net/data-and-products
# Open-Meteo Marine:   https://api.open-meteo.com/v1/marine  (no key needed)
# GBIF:                https://api.gbif.org
